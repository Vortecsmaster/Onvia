{
  "name": "onvia",
  "version": "1.0.1",
  "description": "",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --android",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform web",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "format": "prettier --write src tests app.json package.json tsconfig.json",
    "export:all": "expo export --platform all --output-dir dist-final",
    "build:apk": "expo prebuild --platform android --clean --non-interactive && node plugins/force-release-flags.js && (cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a) && mkdir -p release && cp android/app/build/outputs/apk/release/app-release.apk release/onvia-1.0.0.apk",
    "android:release": "expo run:android --variant release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "^11.3.10",
    "@qvac/sdk": "^0.18.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "bare-rpc": "^1.3.8",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "^1.0.10",
    "expo-constants": "~18.0.14",
    "expo-device": "^8.0.10",
    "expo-file-system": "^19.0.24",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bare-kit": "^0.14.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "bare-pack": "^1.5.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react-native-bare-kit": "0.14.5"
  },
  "private": true
}
